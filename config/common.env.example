# /etc/feymi-backup/common.env   (chmod 600, owner root)
# Part of the name of the Coolify Postgres container (docker ps shows it)
DB_CONTAINER_MATCH=dwdxeo7cdv7qkjn6gvoo3i2w
DB_IMAGE=pgvector/pgvector:pg17
PG_USER=postgres
PG_DB=postgres

# Healthchecks.io check URLs (one per job). Leave empty to skip.
HC_DB=https://hc-ping.com/xxxxxxxx-db
HC_FILES=https://hc-ping.com/xxxxxxxx-files
HC_PRUNE=https://hc-ping.com/xxxxxxxx-prune
HC_DRILL=https://hc-ping.com/xxxxxxxx-drill

# Coolify server only: extra service Postgres DBs dumped by the nightly files job
# (space-separated parts of container names, e.g. the Infisical db container).
EXTRA_PG_MATCH=
