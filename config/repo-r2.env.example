# /etc/feymi-backup/repo-r2.env   (chmod 600) — Cloudflare R2 (second copy)
RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/feymi-backups-dev/restic
RESTIC_PASSWORD_FILE=/etc/feymi-backup/restic-r2.key
AWS_ACCESS_KEY_ID=R2_TOKEN_SCOPED_TO_THIS_BUCKET
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=auto
